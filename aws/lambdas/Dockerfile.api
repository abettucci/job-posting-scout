FROM public.ecr.aws/lambda/python:3.11

ENV PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org"

# Install Typst (single ~8MB Rust binary, used to compile .typ → PDF)
# public.ecr.aws/lambda/python:3.11 is Amazon Linux 2 based — package manager is yum, not dnf.
RUN yum install -y xz tar && \
    curl -fsSL "https://github.com/typst/typst/releases/download/v0.12.0/typst-x86_64-unknown-linux-musl.tar.xz" \
        -o /tmp/typst.tar.xz && \
    tar -xJf /tmp/typst.tar.xz -C /tmp && \
    mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst && \
    chmod +x /usr/local/bin/typst && \
    rm -rf /tmp/typst* && \
    yum clean all

COPY api/requirements.txt .
RUN pip install -r requirements.txt --no-cache-dir

COPY shared/ ${LAMBDA_TASK_ROOT}/shared/
COPY api/ ${LAMBDA_TASK_ROOT}/

CMD ["handler.handler"]
